# EcoLink local configuration. Copy to `.env` (git-ignored) and fill in the values:
#   cp .env.example .env
# Used by: infra/app.py (cdk deploy), scripts/put_secrets.py, seed.py, reset.py, smoke_test.py.
# Empty values are ignored. Nothing in this file is deployed as-is: the Twilio values are
# copied into AWS Secrets Manager by `python scripts/put_secrets.py`.

# -- AWS (needed to deploy and to run the scripts) ---------------------------------------
# Easiest: run `aws configure` once and leave the keys below empty.
AWS_REGION=ap-south-1
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# -- Twilio (WhatsApp messaging + voice calls) --------------------------------------------
# Console: https://console.twilio.com (Account SID + Auth Token are on the dashboard)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp sandbox sender (Messaging > Try it out > Send a WhatsApp message), or your own approved number
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# A Twilio voice-capable phone number in E.164 that places the calls to recyclers
TWILIO_VOICE_FROM=

# -- Demo data (scripts/seed.py, scripts/reset.py) ----------------------------------------
# Real phone that rings when a recycler is offered a pickup (E.164). On a Twilio trial
# account it must be a verified caller ID.
RECYCLER_PHONE=
# The demo household's WhatsApp id; that phone must have joined the Twilio WhatsApp sandbox.
DEMO_USER_ID=whatsapp:+91XXXXXXXXXX

# -- Optional deploy settings -------------------------------------------------------------
# Vision classifier + agent model. apac.* is the cross-region profile usable from ap-south-1.
BEDROCK_MODEL_ID=apac.amazon.nova-pro-v1:0
# Which image classifier answers /classify first. The other is the automatic fallback.
#   bedrock (default) -> Bedrock vision model, then the local YOLOv8n ONNX model if Bedrock fails
#   onnx              -> the local model first (no Bedrock cost, works while Bedrock is unavailable)
CLASSIFY_PRIMARY=bedrock
# Email that receives pickup status notifications from SNS (you must confirm the subscription)
NOTIFY_EMAIL=
# Dashboard origin allowed by CORS, e.g. https://dashboard.example.com ("*" = any origin)
CORS_ORIGIN=*
ECOLINK_PREFIX=EcoLink
TWILIO_SECRET_NAME=ecolink/twilio
# Where the Twilio credentials and API key are stored in AWS:
#   secretsmanager (default)
#   ssm  -> SSM Parameter Store SecureString; use this if Secrets Manager is blocked on your account
SECRETS_BACKEND=secretsmanager
